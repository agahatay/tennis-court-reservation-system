# Copy this file to .env and adjust the values for your environment.
# .env is excluded from version control. Never commit real credentials.

# "development" shows detailed errors in the browser; use "production" otherwise.
APP_ENV=production
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tennis_court_reservation
DB_USER=root
DB_PASSWORD=

# Price of one hour of court time. Reservation prices are always calculated on
# the server from this value and the length of the selected time slot.
HOURLY_RATE=3000
CURRENCY=TL

# Admin sessions expire after this many seconds of inactivity.
SESSION_IDLE_TIMEOUT=1800
